# Dependencies
node_modules/

# Build outputs
dist/

# Local / same name as GitHub Releases “latest” asset
codefig-plugin.zip
codefig-v*-plugin.zip

# Local working notes (streamlining plans, scratch)
.plans/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
!figma-console.log
npm-debug.log*

# Temporary files
*.tmp
*.temp

# Work in progress: the `_` prefix marks scripts the build skips (shouldExclude()).
# Intentionally empty — graduate a script or archive it, don't let these pile up.
scripts/EXAMPLE_SCRIPTS/*.bak*
scripts/EXAMPLE_SCRIPTS/*.temp*
scripts/EXAMPLE_SCRIPTS/*.tmp*
scripts/EXAMPLE_SCRIPTS/*.old*
scripts/EXAMPLE_SCRIPTS/_*.*
figma-console.log
# `/artifacts/*` rather than `/artifacts`, because git does not descend into an excluded directory
# and a negation inside one can never take effect. The target layouts are the fixed goal for the
# panels and have to survive; they link src/ui.css rather than carrying styling, so they cannot
# become a competing style source — which is what artifacts/ui-mockup.html became.
/artifacts/*
!/artifacts/mockup-panels/
/artifacts/mockup-panels/*
!/artifacts/mockup-panels/*-target.html
