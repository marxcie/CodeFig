{
  "name": "codefig",
  "version": "1.0.6",
  "description": "CodeFig - A Figma plugin for running TypeScript/JavaScript scripts with advanced variable management",
  "main": "code.js",
  "scripts": {
    "validate": "node validate-scripts.js",
    "validate:soft": "node validate-scripts.js || true",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:curve": "node --test tests/config-ui-curve.test.js tests/config-ui-curve-scenarios.test.js tests/ui-command-surface.test.js",
    "bench:colors": "node benchmarks/colour-reads.js",
    "devtools:profile-colors-fit": "node devtools/profile-colors-fit.js",
    "devtools:assert-layout": "node devtools/assert-layout.js",
    "devtools:dom-diff-panel": "node devtools/dom-diff-panel.js",
    "devtools:css-coverage": "node devtools/css-coverage.js",
    "devtools:rebuild-count": "node devtools/rebuild-count.js",
    "build:style-reference": "node build-style-reference.js",
    "preview:panel": "node build-panel-preview.js",
    "build:production": "npm run validate && tsc && node build-scripts.js",
    "build:dev": "npm run validate:soft && tsc && node build-scripts.js --dev",
    "dev": "npm run build:dev && concurrently \"tsc --watch\" \"chokidar 'src/ui.html' 'src/ui.css' 'src/config-ui/**/*.js' 'src/import-resolver.js' 'src/foundation-maintain.js' 'scripts/**/*.js' -d 300 -c 'node build-scripts.js --dev'\" \"node figma-console-server.js\"",
    "prepare": "node -e \"const fs=require('fs');const p=require('path');const g=p.join(process.cwd(),'.git','info','exclude');if(!fs.existsSync(p.join(process.cwd(),'.git'))) process.exit(0);let c=fs.existsSync(g)?fs.readFileSync(g,'utf8'):'';if(!c.includes('figma-console.log')) fs.appendFileSync(g,'\\nfigma-console.log\\n');\"",
    "clean": "rm -rf dist",
    "figma:run": "node figma-run.js",
    "figma:ui": "node figma-ui.js",
    "figma:sync": "node figma-sync.js",
    "test:figma": "node figma-test.js",
    "pack": "npm run clean && npm run build:production && node pack-plugin.js",
    "build:release": "node release.js"
  },
  "dependencies": {
    "codemirror": "^5.65.2",
    "marked": "^17.0.1"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.88.0",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^8.2.2",
    "puppeteer-core": "^25.8.0",
    "typescript": "^5.2.2"
  },
  "keywords": [
    "figma",
    "plugin",
    "typescript",
    "variables",
    "scripting"
  ],
  "author": "Marton Lakatos",
  "license": "MIT"
}
