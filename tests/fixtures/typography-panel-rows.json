  {
    "type": "heading",
    "level": 1,
    "text": "Mode settings"
  },
  {
    "type": "field",
    "name": "generateOverview",
    "value": false,
    "label": "Generate overview",
    "labelSpelled": true,
    "tooltip": "",
    "inputType": "boolean",
    "helper": "Builds a Typography overview on the canvas: one specimen tile per text style, grouped by weight."
  },
  {
    "type": "field",
    "name": "modes",
    "value": [
      {
        "name": "Value",
        "scaleType": "bezier",
        "base": 8,
        "ratio": 1.25,
        "curve": [],
        "letterSpacing": {
          "base": 0,
          "max": -2
        },
        "lineHeight": {
          "base": 150,
          "max": 110
        },
        "roundTo": 2
      }
    ],
    "label": "Modes",
    "labelSpelled": true,
    "tooltip": "",
    "inputType": "rows",
    "columns": [
      {
        "key": "name",
        "label": "Mode",
        "type": "text",
        "labelSpelled": true
      },
      {
        "key": "scaleType",
        "label": "Scale type",
        "type": "radio",
        "labelSpelled": true,
        "options": [
          {
            "value": "bezier",
            "label": "Bezier scale"
          },
          {
            "value": "metric",
            "label": "Metric scale"
          },
          {
            "value": "fibonacci",
            "label": "Fibonacci"
          }
        ]
      },
      {
        "key": "curve",
        "label": "Scale",
        "type": "curve",
        "labelSpelled": true,
        "showWhen": [
          {
            "field": "scaleType",
            "values": [
              "bezier"
            ]
          }
        ],
        "helper": "Drag the end handle to set how fast the scale grows. Adding a token extends the range instead of squeezing it. Add shape for tighter small steps and looser large ones.",
        "growth": "ratio"
      },
      {
        "key": "step",
        "label": "Step",
        "type": "number",
        "labelSpelled": true,
        "showWhen": [
          {
            "field": "scaleType",
            "values": [
              "metric",
              "fibonacci"
            ]
          }
        ],
        "helper": "Metric: how much each step adds before growth starts.\nFibonacci: the first increment. Each later step is the sum of the two before it."
      },
      {
        "key": "mod",
        "label": "Every N steps",
        "type": "number",
        "labelSpelled": true,
        "showWhen": [
          {
            "field": "scaleType",
            "values": [
              "metric"
            ]
          }
        ],
        "helper": "How often the step size grows. Step 4 and Every 3 gives 4, 4, 4, 8, 8, 8, 12."
      },
      {
        "key": "base",
        "label": "Base unit",
        "type": "number",
        "labelSpelled": true
      },
      {
        "key": "letterSpacing",
        "label": "Letter spacing",
        "type": "group",
        "labelSpelled": true,
        "helper": "Percent of font size (as Figma shows it). Interpolated between the two ends, then written in pixels.",
        "columns": [
          {
            "key": "base",
            "label": "Base",
            "type": "number",
            "labelSpelled": true,
            "unit": "%"
          },
          {
            "key": "max",
            "label": "Largest",
            "type": "number",
            "labelSpelled": true,
            "unit": "%"
          }
        ],
        "group": "letterSpacing"
      },
      {
        "key": "lineHeight",
        "label": "Line height",
        "type": "group",
        "labelSpelled": true,
        "helper": "Percent of font size. 150 suits body text; use the second field when large sizes need less.",
        "columns": [
          {
            "key": "base",
            "label": "Base",
            "type": "number",
            "labelSpelled": true,
            "unit": "%"
          },
          {
            "key": "max",
            "label": "Largest",
            "type": "number",
            "labelSpelled": true,
            "unit": "%"
          }
        ],
        "group": "lineHeight"
      },
      {
        "key": "roundTo",
        "label": "Round numbers to",
        "type": "number",
        "labelSpelled": true
      }
    ],
    "tabs": true,
    "blocks": false
  },
