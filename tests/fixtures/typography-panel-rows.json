[
  {
    "type": "directive"
  },
  {
    "type": "heading",
    "level": 1,
    "text": "General"
  },
  {
    "type": "field",
    "name": "collectionName",
    "value": "",
    "label": "Collection",
    "labelSpelled": true,
    "tooltip": "",
    "inputType": "collection"
  },
  {
    "type": "chips",
    "label": "Collection modes",
    "from": "modes"
  },
  {
    "type": "field",
    "name": "group",
    "value": "Typography",
    "label": "Group within collection",
    "labelSpelled": true,
    "tooltip": "",
    "inputType": "string",
    "placeholder": "eg.: Typography"
  },
  {
    "type": "field",
    "name": "fontScale",
    "value": [
      "Text-Tiny",
      "Text-Small",
      "Text-Regular",
      "Text-Large",
      "Heading-6",
      "Heading-5",
      "Heading-4",
      "Heading-3",
      "Heading-2",
      "Heading-1"
    ],
    "label": "Tokens",
    "labelSpelled": true,
    "tooltip": "",
    "inputType": "list",
    "helper": "Named smallest to largest, and heading-{6,1} is a series of six. The Base unit below is the size of the first name here."
  },
  {
    "type": "field",
    "name": "fontFamily",
    "value": "Inter",
    "label": "Font family",
    "labelSpelled": true,
    "tooltip": "",
    "inputType": "string",
    "placeholder": "eg.: Inter Tight"
  },
  {
    "type": "field",
    "name": "fontWeights",
    "value": [
      400,
      600
    ],
    "label": "Font weights",
    "labelSpelled": true,
    "tooltip": "",
    "inputType": "list",
    "helper": "A number is a font weight; a word is a Figma font style name, e.g. Semi Bold."
  },
  {
    "type": "field",
    "name": "createStyles",
    "value": true,
    "label": "Create and update text styles",
    "labelSpelled": true,
    "tooltip": "",
    "inputType": "boolean"
  },
  {
    "type": "field",
    "name": "styleNaming",
    "value": "Typography/{$fontScale}/{$fontWeight}",
    "label": "Style naming",
    "labelSpelled": true,
    "tooltip": "",
    "inputType": "string",
    "placeholder": "eg.: Typography/{$fontScale}/{$fontWeight}"
  },
  {
    "type": "divider",
    "section": true
  },
  {
    "type": "heading",
    "level": 1,
    "text": "Mode settings"
  },
  {
    "type": "field",
    "name": "generateOverview",
    "value": false,
    "label": "Generate overview",
    "labelSpelled": true,
    "tooltip": "",
    "inputType": "boolean"
  },
  {
    "type": "field",
    "name": "modes",
    "value": [
      {
        "name": "Value",
        "scaleType": "bezier",
        "base": 8,
        "ratio": 1.25,
        "curve": [],
        "letterSpacing": {
          "base": 0,
          "max": -2
        },
        "lineHeight": {
          "base": 150,
          "max": 110
        },
        "roundTo": 2
      }
    ],
    "label": "Modes",
    "labelSpelled": true,
    "tooltip": "",
    "inputType": "rows",
    "columns": [
      {
        "key": "name",
        "label": "Mode",
        "type": "text",
        "labelSpelled": true
      },
      {
        "key": "scaleType",
        "label": "Scale type",
        "type": "radio",
        "labelSpelled": true,
        "options": [
          {
            "value": "bezier",
            "label": "Bezier scale"
          },
          {
            "value": "metric",
            "label": "Metric scale"
          },
          {
            "value": "fibonacci",
            "label": "Fibonacci"
          }
        ]
      },
      {
        "key": "curve",
        "label": "Scale",
        "type": "curve",
        "labelSpelled": true,
        "showWhen": [
          {
            "field": "scaleType",
            "values": [
              "bezier"
            ]
          }
        ],
        "helper": "Drag the end handle to set how fast the scale grows — the largest value comes out of that and the number of tokens, so adding a token extends the scale instead of squeezing it. Add shape bends the growth: tighter at the small end, looser at the top.",
        "growth": "ratio"
      },
      {
        "key": "step",
        "label": "Step",
        "type": "number",
        "labelSpelled": true,
        "showWhen": [
          {
            "field": "scaleType",
            "values": [
              "metric",
              "fibonacci"
            ]
          }
        ],
        "helper": "Metric. The amount each step adds, before it starts growing.\\nFibonacci. The first increment — the sequence is the base, the base plus this, then each value the sum of the two before it."
      },
      {
        "key": "mod",
        "label": "Every N steps",
        "type": "number",
        "labelSpelled": true,
        "showWhen": [
          {
            "field": "scaleType",
            "values": [
              "metric"
            ]
          }
        ],
        "helper": "How often the step grows. With a step of 4 and a value of 3 the increments run 4, 4, 4, 8, 8, 8, 12 — which is the ladder a design system doc actually writes down."
      },
      {
        "key": "base",
        "label": "Base unit",
        "type": "number",
        "labelSpelled": true
      },
      {
        "key": "letterSpacing",
        "label": "Letter spacing",
        "type": "group",
        "labelSpelled": true,
        "helper": "A percentage of the font size, the way Figma spells it — so it still means the same thing when the scale grows. Interpolated between the two ends and written as pixels.",
        "columns": [
          {
            "key": "base",
            "label": "Base",
            "type": "number",
            "labelSpelled": true,
            "unit": "%"
          },
          {
            "key": "max",
            "label": "Largest",
            "type": "number",
            "labelSpelled": true,
            "unit": "%"
          }
        ]
      },
      {
        "key": "lineHeight",
        "label": "Line height",
        "type": "group",
        "labelSpelled": true,
        "helper": "A percentage of the font size. 150 is a comfortable body line; large text usually wants less, which is what the second field is for.",
        "columns": [
          {
            "key": "base",
            "label": "Base",
            "type": "number",
            "labelSpelled": true,
            "unit": "%"
          },
          {
            "key": "max",
            "label": "Largest",
            "type": "number",
            "labelSpelled": true,
            "unit": "%"
          }
        ]
      },
      {
        "key": "roundTo",
        "label": "Round numbers to",
        "type": "number",
        "labelSpelled": true
      }
    ],
    "tabs": true,
    "blocks": false
  },
  {
    "type": "heading",
    "level": 1,
    "text": "Overview"
  },
  {
    "type": "suggestions"
  },
  {
    "type": "heading",
    "level": 1,
    "text": "Preview"
  },
  {
    "type": "field",
    "name": "overviewPreviewText",
    "value": "Sphinx of black quartz,\njudge my vow.",
    "label": "Preview text",
    "labelSpelled": true,
    "tooltip": "",
    "inputType": "textarea"
  },
  {
    "type": "preview"
  }
]