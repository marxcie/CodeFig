    "text": "General"
  },
  {
    "type": "field",
    "name": "collectionName",
    "value": "",
    "label": "Collection",
    "labelSpelled": true,
    "tooltip": "",
    "inputType": "collection"
  },
  {
    "type": "chips",
    "label": "Collection modes",
    "from": "modes"
  },
  {
    "type": "field",
    "name": "group",
    "value": "",
    "label": "Group within collection",
    "labelSpelled": true,
    "tooltip": "",
    "inputType": "string",
    "placeholder": "eg.: Typography"
  },
  {
    "type": "field",
    "name": "fontScale",
    "value": [],
    "label": "Tokens",
    "labelSpelled": true,
    "tooltip": "",
    "inputType": "list",
    "placeholder": "Text-Tiny, Text-Small, Text-Regular, Heading-1",
    "helper": "Names from smallest to largest. heading-{6,1} expands to six sizes. Base unit is the size of the first name."
  },
  {
    "type": "field",
    "name": "fontFamily",
    "value": "",
    "label": "Font family",
    "labelSpelled": true,
    "tooltip": "",
    "inputType": "string",
    "placeholder": "eg.: Inter Tight"
  },
  {
    "type": "field",
    "name": "fontWeights",
    "value": [],
    "label": "Font weights",
    "labelSpelled": true,
    "tooltip": "",
    "inputType": "list",
    "placeholder": "400, 600",
    "helper": "A number is a weight (400). A word is a Figma style name, e.g. Semi Bold. For a variable font, 450:Regular writes 450 and names the style Regular."
  },
  {
    "type": "field",
    "name": "createStyles",
    "value": true,
    "label": "Create and update text styles",
    "labelSpelled": true,
    "tooltip": "",
    "inputType": "boolean"
  },
  {
    "type": "field",
    "name": "styleNaming",
    "value": "{$fontScale}/{$fontWeight}",
    "label": "Style naming",
    "labelSpelled": true,
    "tooltip": "",
    "inputType": "string",
    "placeholder": "eg.: text/{$fontScale}/{$fontWeight}",
    "helper": "{$fontScale} and {$fontWeight} become the token and weight names. Add a folder with a prefix, e.g. text/{$fontScale}/{$fontWeight}.",
    "fillIfEmpty": "{$fontScale}/{$fontWeight}",
    "showWhenRules": [
      {
        "field": "createStyles",
        "values": [
          "true"
        ]
      }
    ]
  },
  {
    "type": "field",
    "name": "textWrapStyle",
    "value": "AUTO",
    "label": "Text wrap style",
    "labelSpelled": true,
    "tooltip": "",
    "inputType": "radio",
    "options": [
      "AUTO:Auto",
      "BALANCE:Balance",
      "PRETTY:Pretty"
    ],
    "showWhenRules": [
      {
        "field": "createStyles",
        "values": [
          "true"
        ]
      }
    ]
  },
  {
    "type": "divider",
    "section": true
  },
  {
    "type": "heading",
    "level": 1,
    "text": "Mode settings",
    "showWhenRules": [
      {
        "field": "collectionName",
        "values": [
          "*"
        ]
      },
      {
        "field": "fontScale",
        "values": [
          "*"
        ]
      }
    ]
  },
  {
    "type": "field",
    "name": "generateOverview",
    "value": false,
    "label": "Generate overview",
    "labelSpelled": true,
    "tooltip": "",
    "inputType": "boolean",
    "helper": "Builds a Typography overview on the canvas: one specimen tile per text style, grouped by weight.",
    "showWhenRules": [
      {
        "field": "collectionName",
        "values": [
          "*"
        ]
      },
      {
        "field": "fontScale",
        "values": [
          "*"
        ]
      }
    ]
  },
  {
    "type": "field",
    "name": "modes",
    "value": [],
    "label": "Modes",
    "labelSpelled": true,
    "tooltip": "",
    "inputType": "rows",
    "showWhenRules": [
      {
        "field": "collectionName",
        "values": [
          "*"
        ]
      },
      {
        "field": "fontScale",
        "values": [
          "*"
        ]
      }
    ],
    "columns": [
      {
        "key": "name",
        "label": "Mode",
        "type": "text",
        "labelSpelled": true
      },
      {
        "key": "scaleType",
        "label": "Scale type",
        "type": "radio",
        "labelSpelled": true,
        "options": [
          {
            "value": "bezier",
            "label": "Bezier scale"
          },
          {
            "value": "metric",
            "label": "Metric scale"
          },
          {
            "value": "fibonacci",
            "label": "Fibonacci"
          }
        ]
      },
      {
        "key": "curve",
        "label": "Scale",
        "type": "curve",
        "labelSpelled": true,
        "showWhen": [
          {
            "field": "scaleType",
            "values": [
              "bezier"
            ]
          }
        ],
        "helper": "Drag the end handle to set how fast the scale grows. Adding a token extends the range instead of squeezing it. Add shape for tighter small steps and looser large ones.",
        "growth": "ratio"
      },
      {
        "key": "step",
        "label": "Step",
        "type": "number",
        "labelSpelled": true,
        "showWhen": [
          {
            "field": "scaleType",
            "values": [
              "metric",
              "fibonacci"
            ]
          }
        ],
        "helper": "Metric: how much each step adds before growth starts.\nFibonacci: the first increment. Each later step is the sum of the two before it."
      },
      {
        "key": "mod",
        "label": "Every N steps",
        "type": "number",
        "labelSpelled": true,
        "showWhen": [
          {
            "field": "scaleType",
            "values": [
              "metric"
            ]
          }
        ],
        "helper": "How often the step size grows. Step 4 and Every 3 gives 4, 4, 4, 8, 8, 8, 12."
      },
      {
        "key": "base",
        "label": "Base unit",
        "type": "number",
        "labelSpelled": true
      },
      {
        "key": "letterSpacing",
        "label": "Letter spacing",
        "type": "group",
        "labelSpelled": true,
        "helper": "Percent of font size (as Figma shows it). Interpolated between the two ends, then written in pixels.",
        "columns": [
          {
            "key": "base",
            "label": "Base",
            "type": "number",
            "labelSpelled": true,
            "unit": "%"
          },
          {
            "key": "max",
            "label": "Largest",
            "type": "number",
            "labelSpelled": true,
            "unit": "%"
          }
        ],
        "group": "letterSpacing"
      },
      {
        "key": "lineHeight",
        "label": "Line height",
        "type": "group",
        "labelSpelled": true,
        "helper": "Percent of font size. 150 suits body text; use the second field when large sizes need less.",
        "columns": [
          {
            "key": "base",
            "label": "Base",
            "type": "number",
            "labelSpelled": true,
            "unit": "%"
          },
          {
            "key": "max",
            "label": "Largest",
            "type": "number",
            "labelSpelled": true,
            "unit": "%"
          }
        ],
        "group": "lineHeight"
      },
      {
        "key": "roundTo",
        "label": "Round numbers to",
        "type": "number",
        "labelSpelled": true
      }
    ],
    "tabs": true,
    "blocks": false
  },
