    "columns": [
      {
        "key": "name",
        "label": "Mode",
        "type": "text",
        "labelSpelled": true
      },
      {
        "key": "scaleType",
        "label": "Scale type",
        "type": "radio",
        "labelSpelled": true,
        "options": [
          {
            "value": "bezier",
            "label": "Bezier scale"
          },
          {
            "value": "metric",
            "label": "Metric scale"
          },
          {
            "value": "fibonacci",
            "label": "Fibonacci"
          }
        ]
      },
      {
        "key": "curve",
        "label": "Scale",
        "type": "curve",
        "labelSpelled": true,
        "showWhen": [
          {
            "field": "scaleType",
            "values": [
              "bezier"
            ]
          }
        ],
        "helper": "Drag the end handle to set how fast the scale grows. Adding a token extends the range instead of squeezing it. Add shape for tighter small steps and looser large ones.",
        "growth": "ratio"
      },
      {
        "key": "step",
        "label": "Step",
        "type": "number",
        "labelSpelled": true,
        "showWhen": [
          {
            "field": "scaleType",
            "values": [
              "metric",
              "fibonacci"
            ]
          }
        ],
        "helper": "Metric: how much each step adds before growth starts.\nFibonacci: the first increment. Each later step is the sum of the two before it."
      },
      {
        "key": "mod",
        "label": "Every N steps",
        "type": "number",
        "labelSpelled": true,
        "showWhen": [
          {
            "field": "scaleType",
            "values": [
              "metric"
            ]
          }
        ],
        "helper": "How often the step size grows. Step 4 and Every 3 gives 4, 4, 4, 8, 8, 8, 12."
      },
      {
        "key": "base",
        "label": "Base unit",
        "type": "number",
        "labelSpelled": true
      },
      {
        "key": "roundTo",
        "label": "Round numbers to",
        "type": "number",
        "labelSpelled": true
      },
      {
        "key": "extras",
        "label": "Extra values",
        "type": "list",
        "labelSpelled": true,
        "helper": "Off-scale values, merged by size. Put 0 here for a none token: it takes the smallest name and the scale continues above it."
